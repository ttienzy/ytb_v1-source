{
  "name": "google-search-app",
  "version": "0.1.0",
  "description": "Google Search & Studio Recap Desktop App",
  "author": "ttienzy",
  "repository": {
    "type": "git",
    "url": "https://github.com/ttienzy/ytb_v1.git"
  },
  "private": true,
  "type": "module",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && electron-builder"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.6",
    "lucide-react": "^1.33.0",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^38.0.0",
    "electron-builder": "latest",
    "electron-vite": "^5.0.0",
    "ffmpeg-static": "5.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2",
    "vite": "^7.3.6"
  },
  "build": {
    "appId": "com.googlesearch.app",
    "productName": "Google Search App",
    "publish": {
      "provider": "github",
      "owner": "ttienzy",
      "repo": "ytb_v1"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "../Backend/dist/backend_server.exe",
        "to": "bin/backend_server.exe"
      },
      {
        "from": "../services/voice-service/dist/voice_server.exe",
        "to": "bin/voice_server.exe"
      },
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe",
        "to": "bin/ffmpeg.exe"
      },
      {
        "from": "node_modules/ffmpeg-static/LICENSE",
        "to": "licenses/ffmpeg-static-LICENSE.txt"
      },
      {
        "from": "watermark-runtime/node_modules",
        "to": "watermark-runtime/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "watermark-runtime/package.json",
        "to": "watermark-runtime/package.json"
      },
      {
        "from": "watermark-runtime/smoke-test.mjs",
        "to": "watermark-runtime/smoke-test.mjs"
      },
      {
        "from": "../Backend/prompts",
        "to": "prompts"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Google Search App"
    }
  }
}
