# BACKBONE_REPO=pnnbao-ump/VieNeu-TTS-v3-Turbo
# NANO_REPO=pnnbao-ump/VieNeu-TTS-v3-Nano
# MODEL_CACHE_DIR=D:/models/huggingface
# FFMPEG_PATH=D:/bin/ffmpeg.exe
