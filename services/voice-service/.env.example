# Restart voice-service after changing profiles. Default: high-quality CPU.
VOICE_PROFILE=turbo-fp32
# Options: turbo-fp32 | turbo-int8 (VNNI required) | turbo-gpu | nano
THREADS=0
MAX_BATCH_SIZE=8
INFERENCE_WAIT_SECONDS=30
